{
  "manifest_version": 3,
  "name": "万能侧边栏",
  "version": "1.0.0",
  "description": "智能AI侧边栏工具，支持多AI平台切换、网页内容提取、区域截屏等功能",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "tabs",
    "clipboardWrite",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.xiaomimimo.com/*",
    "*://*.mimo.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "万能侧边栏"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["subtitle-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}